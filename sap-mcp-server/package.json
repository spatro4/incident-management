{
  "name": "sap-incident-mcp-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server that bridges SAP (S/4HANA on-prem, SuccessFactors, Ariba) and non-SAP systems (ServiceNow, Jira, PagerDuty, Slack, Teams, email, generic REST/DB) for incident-management workflows.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@aws-sdk/client-secrets-manager": "^3.687.0",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "node-rfc": "^3.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
