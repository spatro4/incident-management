# --- Transport / general ---
MCP_TRANSPORT=stdio            # stdio | http
PORT=8080
MCP_BEARER_TOKEN=              # required for MCP_TRANSPORT=http in production
CLOUD_PROVIDER=env             # env | btp | aws
ENABLED_CONNECTORS=            # comma-separated connector ids, blank = all

# --- SAP SuccessFactors ---
SUCCESSFACTORS_BASE_URL=https://api12.successfactors.com/odata/v2
SUCCESSFACTORS_CLIENT_ID=
SUCCESSFACTORS_CLIENT_SECRET=

# --- SAP Ariba ---
ARIBA_BASE_URL=
ARIBA_API_KEY=
ARIBA_CLIENT_ID=
ARIBA_CLIENT_SECRET=

# --- SAP S/4HANA on-prem RFC (via Cloud Connector) ---
SAP_RFC_ASHOST=
SAP_RFC_SYSNR=00
SAP_RFC_CLIENT=100
SAP_RFC_USER=
SAP_RFC_PASSWORD=
SAP_RFC_LANG=EN
CC_HOST=
CC_PORT=

# --- Solumina (iBase-t MES) ---
SOLUMINA_BASE_URL=
SOLUMINA_CLIENT_ID=
SOLUMINA_CLIENT_SECRET=

# --- eQube (iBase-t digital thread) ---
EQUBE_BASE_URL=
EQUBE_CLIENT_ID=
EQUBE_CLIENT_SECRET=

# --- ServiceNow ---
SERVICENOW_INSTANCE_URL=https://yourinstance.service-now.com
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# --- Jira ---
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- PagerDuty ---
PAGERDUTY_API_KEY=

# --- Slack ---
SLACK_BOT_TOKEN=

# --- Microsoft Teams ---
TEAMS_DEFAULT_WEBHOOK_URL=

# --- SMTP / email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Generic database (Postgres) ---
GENERIC_DB_HOST=
GENERIC_DB_PORT=5432
GENERIC_DB_NAME=
GENERIC_DB_USER=
GENERIC_DB_PASSWORD=
GENERIC_DB_SSL=true

# --- Generic REST ---
ALLOWED_REST_HOSTS=            # comma-separated hostnames
GENERIC_REST_BEARER_TOKEN=
